# peforth AI Providers Configuration Template
# Copy this file to providers.yaml (or ~/.peforth/providers.yaml) and customize it.
# Note: providers.yaml is gitignored to protect private or company-internal endpoints.
# Secrets and API keys must NOT be placed here; store keys in your local .env.

stateful:
  provider: "OpenAI"
  endpoint: "https://api.openai.com/v1"
  model: "gpt-6-luna"
  api_key_env: "OPENAI_API_KEY"

stateless:
  default_profile: "openai-gpt-4o-mini"

  profiles:
    openai-gpt-4o-mini:
      provider: "OpenAI"
      endpoint: "https://api.openai.com/v1"
      model: "gpt-4o-mini"
      reasoning: "none"
      api_key_env: "OPENAI_API_KEY"
      aliases: ["gpt-4o-mini", "4o-mini", "openai"]

    openai-o3-mini:
      provider: "OpenAI"
      endpoint: "https://api.openai.com/v1"
      model: "o3-mini"
      reasoning: "medium"
      api_key_env: "OPENAI_API_KEY"
      aliases: ["o3-mini", "o3"]

    google-gemini-3.8-flash:
      provider: "Google"
      endpoint: "https://generativelanguage.googleapis.com/v1beta/openai/"
      model: "gemini-3.8-flash"
      reasoning: "Medium"
      api_key_env: "GEMINI_API_KEY"
      aliases: ["Gemini 3.8 Flash", "gemini-flash", "gemini", "google"]

    groq-llama-3.3-70b:
      provider: "Groq"
      endpoint: "https://api.groq.com/openai/v1"
      model: "llama-3.3-70b-versatile"
      reasoning: "none"
      api_key_env: "GROQ_API_KEY"
      aliases: ["groq", "llama-3.3"]

    ollama-local:
      provider: "Ollama"
      endpoint: "http://localhost:11434/v1"
      model: "llama3"
      reasoning: "none"
      api_key_env: "OLLAMA_API_KEY"
      aliases: ["ollama", "local"]

    # Example of a company-hosted or custom OpenAI-compatible proxy:
    # my-custom-model:
    #   provider: "MyCompany"
    #   endpoint: "https://proxy.example.com/v1"
    #   model: "custom-model-name"
    #   reasoning: "none"
    #   api_key_env: "CUSTOM_API_KEY"
    #   aliases: ["custom", "proxy"]
