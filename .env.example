# Copy to .env and add your OpenAI Platform API key locally.
OPENAI_API_KEY=
PEFORTH_AI_MODEL=gpt-6-luna
PEFORTH_WSL_DISTRO=Ubuntu
PEFORTH_CONFIG_DIR=~/.peforth
PEFORTH_AI_SKILLS_DIR=skills
PEFORTH_SOURCE_PATH=%USERPROFILE%\OneDrive\Documents\GitHub\peforth

# HTTP request timeout in seconds; default: 30
PEFORTH_AI_REQUEST_TIMEOUT=30
# SSE stream inactivity timeout in seconds; default: 300
PEFORTH_AI_STREAM_TIMEOUT=300
# Total One Shot budget in seconds, including requests, polling, and saved-item retrieval; default: 300
PEFORTH_AI_TURN_TIMEOUT=300
# Delay between one-shot polls in seconds; default: 0.5
PEFORTH_AI_POLL_INTERVAL=0.5
