# ==============================================================================
# peforth v2.1.0 Environment Configuration Template (.env.example)
#
# Copy this file to .env in your runtime directory (~/.peforth/.env)
# or project root and configure your local settings.
# ==============================================================================

# --- AI Assistant & OpenAI-Compatible API Settings ---------------------------

# [Required for AI features] OpenAI API Key or compatible provider secret key.
# Leave blank or omit if you only use ordinary Forth without AI features.
OPENAI_API_KEY=your_openai_api_key_here

# [Optional] Base URL for the OpenAI-compatible Chat Completions endpoint.
# Default: https://api.openai.com/v1
# Can point to OpenAI, Azure OpenAI, Ollama, LiteLLM, vLLM, etc.
OPENAI_BASE_URL=https://api.openai.com/v1

# [Optional] Model identifier used for AI conversation and Forth code generation.
# Default: gpt-6-luna
# Common choices: gpt-6-sol, gpt-6-terra, gpt-6-luna
OPENAI_MODEL=gpt-6-luna

# [Optional] Reasoning effort for reasoning models (e.g. o1, o3-mini).
# Options: none | low | medium | high
# Note: For tool-calling compatibility, peforth defaults to "none" if unset.
# OPENAI_REASONING_EFFORT=none


# --- Diagnostic Logging & Live Supervision ------------------------------------

# [Optional] Diagnostic logging verbosity for ai-diagnostics.sqlite3.
# Options:
#   normal   - (Default) Records runtime lifecycle, AI turns, tool calls, and approval events.
#   verbose  - In addition to normal, records granular SSE chunks and payload details.
#   disabled - Turns off SQLite diagnostic logging completely.
PEFORTH_AI_LOG_MODE=normal

# [Optional] Custom runtime configuration and diagnostics database directory.
# Default: ~/.peforth (Windows: %USERPROFILE%\.peforth)
# If set, .env and ai-diagnostics.sqlite3 will be located under this directory.
# PEFORTH_CONFIG_DIR=%USERPROFILE%\.peforth

# [Optional] Source repository checkout directory (for development / source edits).
# Default: runtime directory if unset.
# PEFORTH_SOURCE_PATH=/path/to/peforth  # Optional; defaults to the runtime directory.

# [Optional] Skills directory path and WSL/PowerShell overrides.
# PEFORTH_SKILLS_DIR=skills
# PEFORTH_WSL_DISTRO=Ubuntu
# PEFORTH_PWSH_PATH=/path/to/pwsh  # Only if automatic PowerShell detection fails.

# ----- Optional LINE Messaging API credentials -----------------------------------
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# LINE_USER_ID=your_line_user_id
